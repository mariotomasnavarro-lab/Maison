# Copiez ce fichier vers .env pour un lancement local. En production, définissez ces valeurs dans Render.
NODE_ENV=production
PORT=3000
DATA_DIR=./data
# Générez une longue valeur aléatoire (au moins 32 octets) et gardez-la privée.
SESSION_SECRET=remplacer-par-une-cle-aleatoire-longue-et-secrete
# URL HTTPS publique facultative, utile pour les QR codes d’invitation.
APP_URL=https://votre-app.onrender.com
